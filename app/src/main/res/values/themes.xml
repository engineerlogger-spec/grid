<resources>
    <!-- Splash (androidx.core.splashscreen); Compose draws everything after it. -->
    <style name="Theme.Grid.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Grid</item>
    </style>

    <style name="Theme.Grid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F3F2EC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
