<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon: the fastest ways into Grid. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_expense"
        android:shortcutLongLabel="@string/shortcut_add_expense">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.grid.app"
            android:targetClass="com.grid.app.MainActivity">
            <extra android:name="grid.launch" android:value="ADD_EXPENSE" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_add_income"
        android:shortcutLongLabel="@string/shortcut_add_income">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.grid.app"
            android:targetClass="com.grid.app.MainActivity">
            <extra android:name="grid.launch" android:value="ADD_INCOME" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="bills"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_bills"
        android:shortcutShortLabel="@string/shortcut_bills"
        android:shortcutLongLabel="@string/shortcut_bills">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.grid.app"
            android:targetClass="com.grid.app.MainActivity">
            <extra android:name="grid.launch" android:value="BILLS" />
        </intent>
    </shortcut>
</shortcuts>
